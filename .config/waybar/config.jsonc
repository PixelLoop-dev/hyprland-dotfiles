{
	"layer": "top",
	"modules-left": ["custom/launcher","cpu", "memory", "custom/gpu", "hyprland/workspaces"],
	"modules-center": ["clock"],
	"modules-right": ["tray", "network","hyprland/language","pulseaudio","custom/power"],

    "cpu": {
        "interval": 5,
        "format": "  {usage}%",
        "min-length": 6
    },

    "memory": {
        "interval": 5,
        "format": "  {}%",
        "min-length": 6
    },

    "network": {
        "interface": "wlan0",
        "interval": 2,
        "max-width": 10,
        "format": "{ifname} ⇣{bandwidthDownBits} ⇡{bandwidthUpBits}",
        "format-wifi": "⇣{bandwidthDownBits} ⇡{bandwidthUpBits}",
        "format-disconnected": "offline"
    },

    "custom/gpu": {
        "exec": "nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits",
        "format": "  {}%",
        "interval": 5,
        "min-length": 6
    },

    "hyprland/workspaces": {
        "format": "{icon}",
        "tooltip": true,
        "format-icons": {
            "1": "",
            "2": "",
            "3": "",
            "4": "",
            "5": "",
            "urgent": "",
            "active": "",
            "default": ""
  	 }
    },




    "clock": {
        "format": "  {:%A - %B %d, %Y - %R}",
        "tooltip": true,
        "on-click": "gsimplecal"
    },




	"pulseaudio": {
		"scroll-step": 5,
		"format": "{icon}  {volume}%",
		"format-muted": "Muted",
		"on-click":"pavucontrol",
		"format-icons": {
			"default": ["", "", ""]
		},
        "min-length": 6
	},

    "tray": {
        "icon-size": 18,
        "spacing": 10
    },

    "cava": {
        "framerate": 60,
        "bars": 14,
        "method": "pipewire",
        "autosens": 1,
        "sensitivity": 7,
        "colors": ["#E0D1CF"],
        "lower_cutoff_freq": 50,
        "higher_cutoff_freq": 10000,
        "source": "auto",
        "stereo": false,
        "reverse": true ,
        "bar_delimiter": 0,
        "monstercat": false,
        "waves": false,
        "noise_reduction": 0.25,
        "input_delay": 2,
        "format-icons" : ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█" ]
    },

    "custom/launcher":{
        "format": " "
        // "on-click": "rofi -show drun",
    },

    "hyprland/language": {
        "format" :"{}",
        "min-length": 6,
        "format-ru": "  RUS",
        "format-en": "  ENG",
        "on-click": "hyprctl switchxkblayout all next"
    },

    "custom/power":{
        "format": " ⏻ ",
        "tooltip": false,
        "on-click": "~/.config/wofi/power-menu/./power-menu.sh"
    }
}
