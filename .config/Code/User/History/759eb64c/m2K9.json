{
  // === Редактор ===
  "editor.fontFamily": "JetBrains Mono NL, 'Courier New', monospace",
  "editor.fontLigatures": true,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.quickSuggestions": {
    "other": true,
    "comments": true,
    "strings": true
  },
  "editor.inlineSuggest.enabled": false,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorBlinking": "expand",
  "editor.smoothScrolling": true,
  "editor.minimap.enabled": false,
  "breadcrumbs.enabled": false,

  // === Рабочая среда (Workbench) ===
  "workbench.colorTheme": "Catppuccin Mocha",
  "workbench.iconTheme": "catppuccin-mocha",
  "catppuccin.accentColor": "peach",
  "workbench.list.smoothScrolling": true,
  "workbench.tree.indent": 14,

  // === Файловый менеджер ===
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmPasteNative": false,
  "explorer.compactFolders": false,
  "explorer.confirmDelete": false,
  "files.autoSave": "afterDelay",

  // === Безопасность ===
  "security.workspace.trust.untrustedFiles": "open",

  // === GitHub Copilot ===
  "github.copilot.inlineSuggest.enable": false,
  "github.copilot.suggestion.enableAutoCompletions": false,


  // === Терминал ===
  "terminal.integrated.profiles.windows": {
    "Git Bash": {
      "path": "C:\\Program Files\\Git\\bin\\bash.exe"
    },
    "WSL": {
      "path": "C:\\Windows\\System32\\wsl.exe"
    }
  },
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "debug.console.fontFamily": "'JetBrains Mono NL'",
  "terminal.integrated.cursorStyle": "line"
}