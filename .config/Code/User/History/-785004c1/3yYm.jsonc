{
	"layer": "top",
	"modules-left": ["custom/launcher","cpu","memory", "custom/gpu", "hyprland/workspaces"],
	"modules-center": ["clock"],
	"modules-right": ["tray","cava","hyprland/language","pulseaudio","battery","custom/power"],
	
    "custom/launcher":{
        "format": " ",
        // "on-click": "rofi -show drun",
        "min-length": 5
    },

    "cpu": {
        "interval": 5,
        "format": "  {usage}%",
        "min-length": 5
    },

    "memory": {
        "interval": 5,
        "format": "  {}%",
        "min-length": 5
    },

    "network": {
        "interface": "wlan0",
        "interval": 2,
        "format": "{ifname} ⇣{bandwidthDownBits} ⇡{bandwidthUpBits}",
        "format-wifi": "⇣{bandwidthDownBits} ⇡{bandwidthUpBits}",
        "format-disconnected": "offline"
    },

    "custom/gpu": {
        "exec": "nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits",
        "format": "  {}%",
        "interval": 5,
        "min-length": 5
    },

    "hyprland/workspaces": {
        "format": "{icon}",
        "tooltip": false,
        "format-icons": {
            "1": "",
            "2": "",
            "3": "",
            "4": "",
            "5": "",
            "urgent": "",
            "active": "",
            "default": ""
  	 }
    },




    "clock": {
        "format": "  {:%A - %B %d, %Y - %R}",
        "tooltip": false
    },




	"pulseaudio": {
		"scroll-step": 5,
		"format": "{icon}  {volume}%",
		"format-muted": "Muted",
		"on-click":"pavucontrol",
		"format-icons": {
			"default": ["", "", ""]
		},
        "min-length": 5
	},

    "tray": {
        "icon-size": 18,
        "spacing": 10
    },

    "cava": {
        "framerate": 144,
        "autosens": 1,
        "sensitivity": 4,
        "bars":12,
        "lower_cutoff_freq": 50,
        "higher_cutoff_freq": 10000,
        "method": "pulse",
        "source": "auto",
        "stereo": false,
        "reverse": false,
        "bar_delimiter": 0,
        "monstercat": true,
        "waves": true,
        "noise_reduction": 0.77,
        "input_delay": 0,
        "format-icons" : ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█" ]
    },

    "hyprland/language": {
        "format" :"  {short}"
    },

    "custom/power":{
        "format": " ⏻ ",
        "tooltip": false
    }
}
