{
	"layer": "top",
	"modules-left": ["custom/launcher","cpu","memory", "network", "hyprland/workspaces"],
	"modules-center": ["clock"],
	"modules-right": ["tray","cava","hyprland/language","backlight","pulseaudio","battery","custom/power"],
	
	"pulseaudio": {
		"tooltip": false,
		"scroll-step": 5,
		"format": "{icon}  {volume}%",
		"format-muted": "Muted",
		"on-click":"pavucontrol",
		"format-icons": {
			"default": ["", "", ""]
		}
	},

    "cava": {
        "framerate": 144,
        "autosens": 1,
        "sensitivity": 4,
        "bars":12,
        "lower_cutoff_freq": 50,
        "higher_cutoff_freq": 10000,
        "method": "pulse",
        "source": "auto",
        "stereo": false,
        "reverse": false,
        "bar_delimiter": 0,
        "monstercat": true,
        "waves": true,
        "noise_reduction": 0.77,
        "input_delay": 0,
        "format-icons" : ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█" ]
    },

    "battery": {
        "bat": "BAT0",
        "interval": 60,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}  {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "max-length": 25
    },

    "tray": {
        "icon-size": 18,
        "spacing": 10
    },

    "custom/language": {
        "format" : ""
    },

    "cpu": {
        "interval": 1,
        "format": "  {}%",
        "max-length": 10
    },

    "memory": {
        "interval": 1,
        "format": "  {}%",
        "max-length": 10
    },

    "custom/launcher":{
        "format": " ",
        // "on-click": "rofi -show drun",
        "tooltip": false
    },

    "custom/power":{
        "format": " ⏻ ",
        "tooltip": false
    },
    "network": {
        "interface": "wlan0",

        // Частота обновления (секунды)
        "interval": 2,

        // Формат по умолчанию (если не сработает wifi-формат)
        "format": "{ifname} ⇣{bandwidthDownBits} ⇡{bandwidthUpBits}",

        // Формат, когда интерфейс — WiFi
        "format-wifi": "⇣{bandwidthDownBits} ⇡{bandwidthUpBits}",

        // Что показывать, когда нет соединения
        "format-disconnected": "offline"
    },

    "custom/gpu": {
        "exec": "nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits",
        "format": "  {}%",
        "interval": 5,
        "tooltip": false
    },

    "clock": {
        "format": "  {:%A - %B %d, %Y - %R}",
        "tooltip": false
    },
    
    "hyprland/workspaces": {
        "format": "{icon}",
        "tooltip": false,
        "format-icons": {
            "1": "",
            "2": "",
            "3": "",
            "4": "",
            "5": "",
            "urgent": "",
            "active": "",
            "default": ""
  	 }
    }
}
