{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",

    "color": {
      "1": "#fab387",
      "2": "#fab387"
    },

    "height": 1,
    "width": 1,
    "padding": {
      "top": 0,
      "left": 1
    }
  },

  "display": {
    "separator": " - ",
    "color"
  },

  "modules": [
    {
      "type": "title",
      "color": {
        "user": "#fab387",
        "at": "#cdd6f4",
        "host": "#cdd6f4"
      }
    },
    "separator",
    {
      "type": "os",
      "key": "OS",
      "keyColor": "38;2;87;163;201"
    },
    {
      "type": "wm",
      "keyColor": "38;2;87;163;201"
    }
  ]
}