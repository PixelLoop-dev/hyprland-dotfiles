{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",

    "color": {
      "1": "#fab387",
      "2": "#fab387"
    },

    "height": 1,
    "width": 1,
    "padding": {
      "top": 0,
      "left": 5
    }
  },

  "display": {
    "separator": " - ",
    "color": {
      "output": "#cdd6f4",
      "separator": "#cdd6f4",
      "keys": "#fab387"
    }
  },

  "modules": [
    {
      "type": "title",
      "color": {
        "user": "#fab387",
        "at": "#cdd6f4",
        "host": "#cdd6f4"
      }
    },

    "separator",

    "os",
    "wm",
    "uptime",

    "separator",

    "disk",
    {
      "type": "weather",
      "location": "Samara"
    }

  ]
}