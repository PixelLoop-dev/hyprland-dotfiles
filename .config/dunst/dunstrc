[global]
monitor = 0
follow = mouse
width = (300, 800)
height = (0, 300)
origin = top-right
offset = (30, 30)
scale = 0
notification_limit = 5

font = JetBrainsMono Nerd Font 12
line_height = 0
markup = full
format = "<b>%s</b>\n%b"
alignment = left

padding = 10
horizontal_padding = 10
icon_position = left
max_icon_size = 64

frame_width = 2
frame_color = "#282F34"
separator_height = 2
separator_color = frame

word_wrap = yes
corner_radius = 10

mouse_left_click = do_action
mouse_middle_click = close_current
mouse_right_click = close_all


[urgency_low]
background = "#191d21cf"
foreground = "#D9CECC"
timeout = 8

[urgency_normal]
background = "#191d21cf"
foreground = "#D9CECC"
timeout = 8

[urgency_critical]
background = "#191d21cf"
foreground = "#f38ba8"
frame_color = "#f38ba8"
timeout = 0
